# ============================================================
# SIM Skripsi Backend - Template Environment (.env.example)
# Salin file ini menjadi .env lalu isi nilainya.
#   cp .env.example .env
# ============================================================

# Port server Express
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------
# PostgreSQL / Neon (Neon Console > Connect)
# DATABASE_URL = koneksi POOLED (hostname berakhiran -pooler) untuk APLIKASI.
# DIRECT_URL   = koneksi DIRECT/unpooled untuk Prisma CLI (migrate, seed, studio).
# ------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@endpoint-pooler.region.aws.neon.tech/dbname?sslmode=require&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@endpoint.region.aws.neon.tech/dbname?sslmode=require"

# (Opsional) Shadow database untuk `prisma migrate dev` di Neon.
# Buat database/branch khusus, jangan pakai database produksi.
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@endpoint.region.aws.neon.tech/shadow_dbname?sslmode=require"

# ------------------------------------------------------------
# Autentikasi SSO (JWT)
# Harus sama dengan konfigurasi di sim-mhs-api.
# ------------------------------------------------------------
JWT_SECRET=rahasia_bersama_sim_mahasiswa_sso
JWT_ISSUER=sim-mhs-api
