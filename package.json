{
  "name": "sim_skripsi_be",
  "version": "1.0.0",
  "description": "Backend RESTful API Sistem Informasi Manajemen Skripsi (SIM Skripsi)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:baseline": "prisma migrate resolve --applied 0_init",
    "seed": "prisma db seed",
    "studio": "prisma studio",
    "token": "node generate_token.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "prisma": "^7.10.0"
  }
}
